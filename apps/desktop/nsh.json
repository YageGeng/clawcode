{
  "name": "Clawcode",
  "id": "com.clawcode.desktop",
  "version": "0.1.0",
  "build": 1,
  "rust": "ext/backend",
  "theme": "theme.json",
  "appearance": "system",
  "application": {
    "quitMode": "lastWindowClosed"
  },
  "window": {
    "title": "Clawcode",
    "defaultSize": {
      "width": 1200,
      "height": 800
    },
    "minSize": {
      "width": 800,
      "height": 560
    },
    "restoreBounds": true
  },
  "capabilities": {
    "application": true,
    "clipboard": true,
    "picker": true,
    "process": {
      "env": [
        "CLAW_CONFIG",
        "CLAW_DESKTOP_RELAY"
      ]
    },
    "windows": true,
    "openUrl": {
      "schemes": [
        "https"
      ]
    }
  }
}
